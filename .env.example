# sql-mcp configuration. Copy to backend/.env (the server reads .env from its
# working directory) or set the variables in the environment.

# ── Where the app is reached ───────────────────────────────────────────────
# Every MCP URL, OAuth issuer and redirect is derived from this. No trailing slash.
APP_BASE_URL=http://localhost:3000
# Plain HTTP port. With SSL_ENABLED it only redirects to HTTPS.
HTTP_PORT=3000
# The built web app (frontend/dist). `make build` copies it here.
PUBLIC_DIR=./public

# ── Secrets (required) ─────────────────────────────────────────────────────
# Signs every session, OAuth client id, code and token. At least 32 characters:
#   openssl rand -base64 48
JWT_SECRET=
# AES-256 key sealing database DSNs, tmphost tokens and the admin's saved
# configuration at rest. 32 bytes, as 64 hex characters or base64:
#   openssl rand -hex 32
# Changing it makes all of them unreadable, and the server refuses to start
# while a saved configuration cannot be decrypted.
ENCRYPTION_KEY=

# ── Who may sign in ────────────────────────────────────────────────────────
# Comma separated; an admin can override it at /admin. Each entry is an exact
# address, a glob (`*` matches any run of characters), or a regular expression
# prefixed with `re:`. Matching is case-insensitive and anchored to the whole
# address. Empty admits nobody.
#   ALLOWED_EMAILS=*@agentrq.com, alice@example.org, re:^[a-z]+\.ops@example\.net$
ALLOWED_EMAILS=

# Google sign-in. Authorized redirect URI: <APP_BASE_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ROOT_TOKEN (at least 16 characters) opens the admin setup at /admin, where the
# allowlist and query limits can be changed at runtime; unset, /admin is disabled.
# ROOT_LOGIN_ENABLED also lets it sign in to the app as ROOT_EMAIL, which must
# itself be on the allowlist. Generate one with: openssl rand -base64 32
ROOT_LOGIN_ENABLED=false
ROOT_TOKEN=
ROOT_EMAIL=root@sqlmcp.local

# ── Let's Encrypt ──────────────────────────────────────────────────────────
# DNS-01 through Cloudflare, so neither port has to be 80 or 443 and the server
# needs no inbound access from Let's Encrypt. The certificate is renewed 30
# days before expiry, without a restart.
SSL_ENABLED=false
HTTPS_PORT=3443
APP_DOMAIN=
LETSENCRYPT_EMAIL=
# A token with Zone:DNS:Edit on APP_DOMAIN's zone.
CLOUDFLARE_API_TOKEN=
SSL_CACHE_DIR=./_data/certs
# The staging directory, for trying it out without hitting rate limits:
#   https://acme-staging-v02.api.letsencrypt.org/directory
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory

# ── The app's own database ─────────────────────────────────────────────────
# sqlite (a file) or postgres (a DSN). This holds accounts, connections and PII
# lists, not the databases the MCP servers query.
APP_DB_DRIVER=sqlite
APP_DB_DSN=./_data/sqlmcp.db

# ── Query results (an admin can override these at /admin) ──────────────────
# Rows read at most per query.
QUERY_MAX_ROWS=1000
# Rows an MCP client gets inline (as TOON). A larger result is stored whole as CSV on the
# owner's tmphost.io (30 minutes) and its URL returned with a preview.
QUERY_INLINE_ROWS=25
QUERY_TIMEOUT=30s
TMPHOST_API_URL=https://app.tmphost.io
